{
  // --- Toolchain discovery (no global PATH changes) ---
  "cmake.environment": {
    "PATH": "C:\\ST\\STM32CubeCLT_1.22.0\\GNU-tools-for-STM32\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\CMake\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\Ninja\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\STM32CubeProgrammer\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\STLink-gdb-server\\bin;${env:PATH}"
  },
  "terminal.integrated.env.windows": {
    "PATH": "C:\\ST\\STM32CubeCLT_1.22.0\\GNU-tools-for-STM32\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\CMake\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\Ninja\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\STM32CubeProgrammer\\bin;C:\\ST\\STM32CubeCLT_1.22.0\\STLink-gdb-server\\bin;${env:PATH}"
  },

  // --- CMake Tools ---
  "cmake.useCMakePresets": "always",
  "cmake.generator": "Ninja",
  "cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",

  // --- Cortex-Debug ---
  "cortex-debug.armToolchainPath": "C:\\ST\\STM32CubeCLT_1.22.0\\GNU-tools-for-STM32\\bin",
  "cortex-debug.gdbPath": "C:\\ST\\STM32CubeCLT_1.22.0\\GNU-tools-for-STM32\\bin\\arm-none-eabi-gdb.exe",

  // --- IntelliSense ---
  // The ST clangd extension activates on every C/C++ file but CubeCLT ships no
  // clangd server, so it hijacks navigation requests and drops them.
  "stm32cube-ide-clangd.enable": false,

  // CMake Tools feeds cpptools the real per-file compile flags from the active preset.
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.default.intelliSenseMode": "gcc-arm",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.cppStandard": "c++17",

  // Overrides the global user setting. cpptools' clang-tidy runs as a separate
  // analyzer with its own clang and does not pick up the arm-none-eabi target,
  // so it parses CMSIS headers as host x86-64 and fails on "Unknown compiler".
  "C_Cpp.codeAnalysis.clangTidy.enabled": false,
  "C_Cpp.codeAnalysis.runAutomatically": false,

  // Fallback for headers, which are not compilation units and so cannot be
  // configured by the provider. Paths mirror cmake/stm32cubemx/CMakeLists.txt.
  "C_Cpp.default.compilerPath": "C:/ST/STM32CubeCLT_1.22.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc.exe",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}",
    "${workspaceFolder}/Core/Inc",
    "${workspaceFolder}/api",
    "${workspaceFolder}/api/u8g2",
    "${workspaceFolder}/app",
    "${workspaceFolder}/app/hot_plate",
    "${workspaceFolder}/app/menu/graph_lib",
    "${workspaceFolder}/bsp",
    "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc",
    "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc/Legacy",
    "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
    "${workspaceFolder}/Drivers/CMSIS/Include"
  ],
  "C_Cpp.default.defines": [
    "USE_HAL_DRIVER",
    "STM32F103xB",
    "DEBUG"
  ],

  "files.associations": { "*.ld": "linkerscript" }
}